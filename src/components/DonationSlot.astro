---
import { site } from "../data/site";

/**
 * OFUSE の応援・ファンレター導線。
 * href / label を差し替えるか、slot で独自ウィジェットを配置できます。
 */
interface Props {
  href?: string;
  label?: string;
  class?: string;
  compact?: boolean;
}

const {
  href = site.donation.href,
  label = site.donation.label,
  class: className = "",
  compact = false,
} = Astro.props;
---

<div
  class:list={[
    "donation-slot",
    compact ? "" : "card-surface p-4 sm:p-5",
    className,
  ]}
  data-donation-slot
>
  <slot>
    {
      compact ? (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-sm border border-gold-400/50 bg-gold-400/15 px-3 py-1.5 text-sm font-medium text-gold-300 transition hover:bg-gold-400/25 hover:text-cream-100"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M4 6.5h16v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-11Z" stroke-linejoin="round" />
            <path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{label}</span>
        </a>
      ) : (
        <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-lg font-bold text-cream-100">開発を応援する</p>
            <p class="mt-1 text-sm text-mist-400">
              プラグインは無料配布です。OFUSEから応援メッセージや支援をお送りいただけると嬉しいです。
            </p>
          </div>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center gap-2 rounded-sm border border-gold-400/50 bg-gold-400/15 px-4 py-2.5 text-sm font-bold text-gold-300 transition hover:bg-gold-400/25 hover:text-cream-100"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M4 6.5h16v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-11Z" stroke-linejoin="round" />
              <path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{label}</span>
          </a>
        </div>
      )
    }
  </slot>
</div>

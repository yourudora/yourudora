---
import type { PickupItem } from "../data/site";

interface Props {
  item: PickupItem;
}

const { item } = Astro.props;
const kindLabel = item.kind === "plugin" ? "プラグイン" : "ゲーム";
---

<a
  href={item.href}
  class="group flex h-full flex-col border border-forest-600 bg-forest-800 p-5 shadow-sm transition duration-300 hover:border-gold-400/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-400/60"
>
  <div class="flex items-center justify-between gap-3">
    <span class="text-xs font-medium text-moss-500">{kindLabel}</span>
    {
      item.status && (
        <span class="rounded-sm border border-wood-500/30 bg-wood-600/10 px-2 py-0.5 text-[0.7rem] text-wood-600">
          {item.status}
        </span>
      )
    }
  </div>
  <h3 class="mt-3 text-xl font-bold tracking-tight text-cream-100 transition group-hover:text-gold-400">
    {item.title}
  </h3>
  <p class="mt-2 flex-1 whitespace-pre-line text-sm leading-relaxed text-mist-400">{item.summary}</p>
  <p class="mt-4 text-xs tracking-wide text-moss-400">{item.meta}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-gold-400 opacity-90 transition group-hover:opacity-100">
    詳しく見る
    <svg class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
      ></path>
    </svg>
  </span>
</a>

---
import CatalogCard from "./CatalogCard.astro";
import type { PluginItem } from "../data/plugins";
import { getPluginImage } from "../data/plugins";

interface Props {
  plugin: PluginItem;
  class?: string;
}

const { plugin, class: className = "" } = Astro.props;
---

<CatalogCard
  href={`/plugins/${plugin.slug}/`}
  title={plugin.title}
  description={plugin.shortDescription}
  imageSrc={getPluginImage(plugin)}
  imageAlt={plugin.imageAlt ?? `${plugin.title}のアイキャッチ画像`}
  genre={plugin.category}
  meta={plugin.engine}
  class={className}
/>

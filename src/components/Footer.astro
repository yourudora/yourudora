---
import { navItems, site } from "../data/site";
import DonationSlot from "./DonationSlot.astro";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-forest-600 bg-forest-950">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
    <div>
      <p class="text-lg font-bold text-cream-100">{site.name}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-mist-400">{site.description}</p>
      <div class="mt-5">
        <DonationSlot compact />
      </div>
    </div>

    <div>
      <p class="text-xs font-medium text-mist-500">メニュー</p>
      <ul class="mt-3 space-y-2">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-cream-200 hover:text-gold-300">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-xs font-medium text-mist-500">ソーシャル</p>
      <ul class="mt-3 space-y-2">
        <li>
          <a href={site.social.twitter} class="text-sm text-cream-200 hover:text-gold-300" target="_blank" rel="noopener noreferrer"
            >X（旧Twitter）</a
          >
        </li>
        <li>
          <a href={site.social.github} class="text-sm text-cream-200 hover:text-gold-300" target="_blank" rel="noopener noreferrer"
            >GitHub</a
          >
        </li>
        <li>
          <a href={site.social.youtube} class="text-sm text-cream-200 hover:text-gold-300" target="_blank" rel="noopener noreferrer"
            >YouTube</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-forest-600">
    <p class="mx-auto max-w-6xl px-4 py-4 text-center text-xs text-mist-500 sm:px-6 lg:px-8">
      © {year} {site.author} / {site.name}
    </p>
  </div>
</footer>

---
/**
 * Shared catalog card: image-dominant layout + overlay tags.
 * Cyber-modern neon glass styling; entire card navigates to detail.
 */
interface Props {
  href: string;
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  /** Genre / category badge (e.g. バトル) */
  genre?: string;
  /** Engine or type badge (e.g. RPGツクールMZ) */
  engine?: string;
  class?: string;
}

const {
  href,
  title,
  description,
  imageSrc,
  imageAlt,
  genre,
  engine,
  class: className = "",
} = Astro.props;

const displayUrl = href.replace(/\/$/, "") || href;
const badges = [genre, engine].filter((value): value is string => Boolean(value));
---

<article class:list={["cyber-card group", className]}>
  <div class="cyber-card__aura" aria-hidden="true"></div>
  <div class="cyber-card__inner">
    <!-- Full-card link (covers image + text; prevents bare image navigation) -->
    <a
      href={href}
      class="absolute inset-0 z-20 rounded-[inherit] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300/70"
      aria-label={`${title}の詳細を見る`}
    >
      <span class="sr-only">{title}の詳細へ</span>
    </a>

    <!-- Image area (~80%+) with overlay badges -->
    <div class="cyber-card__media">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="pointer-events-none absolute inset-0 h-full w-full object-cover transition duration-300 ease-in-out group-hover:scale-105"
        loading="lazy"
        decoding="async"
        draggable="false"
      />
      <div class="cyber-card__media-shade" aria-hidden="true"></div>

      {
        badges.length > 0 && (
          <ul class="cyber-card__badges">
            {badges.map((badge, index) => (
              <li class:list={["cyber-card__badge", index === 0 ? "is-genre" : "is-engine"]}>
                {badge}
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <!-- Compact text: title 1 line + description 2 lines -->
    <div class="cyber-card__body">
      <h3 class="cyber-card__title">{title}</h3>
      <p class="cyber-card__desc">{description}</p>
    </div>

    <!-- URL slides up on hover -->
    <div class="cyber-card__url" aria-hidden="true">
      <span class="cyber-card__url-text">{displayUrl}</span>
    </div>
  </div>
</article>

---
import Layout from "../../layouts/Layout.astro";
import DonationSlot from "../../components/DonationSlot.astro";
import { getGameBySlug, getGameImage, games } from "../../data/games";

export function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
  }));
}

const { slug } = Astro.params;
const game = getGameBySlug(slug ?? "");

if (!game) {
  return Astro.redirect("/games/");
}

const imageSrc = getGameImage(game);
const imageAlt = game.imageAlt ?? `${game.title}のアイキャッチ画像`;

const statusTone: Record<string, string> = {
  開発中: "border-wood-500/50 bg-wood-600/20 text-wood-500",
  デモ公開中: "border-moss-500/50 bg-moss-500/15 text-moss-400",
  リリース済み: "border-gold-400/50 bg-gold-400/15 text-gold-300",
};
---

<Layout title={game.title} description={game.shortDescription}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
    <p class="text-sm">
      <a href="/games/" class="text-mist-400 hover:text-gold-300">ゲーム一覧</a>
      <span class="mx-2 text-mist-500" aria-hidden="true">/</span>
      <span class="text-cream-200">{game.title}</span>
    </p>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:items-start">
      <div class="card-surface overflow-hidden">
        <img
          src={imageSrc}
          alt={imageAlt}
          class="aspect-[4/3] w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          <time class="font-mono text-xs text-mist-500" datetime={game.updatedAt}>
            {game.updatedAt}
          </time>
          <span class:list={["rounded-sm border px-2 py-0.5 text-[0.7rem]", statusTone[game.status]]}>
            {game.status}
          </span>
          <span class="text-xs text-mist-500">{game.platforms}</span>
        </div>

        <h1 class="mt-3 text-3xl font-bold tracking-tight text-cream-100 sm:text-4xl">
          {game.title}
        </h1>
        <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-mist-400 sm:text-base">
          {game.description}
        </p>
      </div>
    </div>

    <div class="mt-12">
      <DonationSlot />
    </div>
  </section>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import CatalogControls from "../../components/CatalogControls.astro";
import DonationSlot from "../../components/DonationSlot.astro";
import GameCard from "../../components/GameCard.astro";
import { getGameGenres, getGamesNewestFirst } from "../../data/games";

const games = getGamesNewestFirst();
const genres = getGameGenres();
---

<Layout title="ゲーム" description="開発中・リリース済みの自作ゲーム紹介。">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h1 class="text-3xl font-bold tracking-tight text-cream-100 sm:text-4xl">ゲーム一覧</h1>
      <CatalogControls listId="games-page" genres={genres} />
    </div>

    <div
      class="mt-8 grid grid-cols-1 gap-5 overflow-visible py-2 sm:grid-cols-2 lg:grid-cols-3"
      data-sort-grid="games-page"
    >
      {
        games.map((game) => (
          <div
            data-sort-item
            data-updated-at={game.updatedAt}
            data-name={game.title}
            data-genre={game.genre}
          >
            <GameCard game={game} />
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-mist-400" data-filter-empty="games-page" hidden>
      該当するジャンルのゲームはありません。
    </p>

    <div class="mt-12">
      <DonationSlot />
    </div>
  </section>
</Layout>

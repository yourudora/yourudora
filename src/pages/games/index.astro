---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { games } from "../../data/site";

const statusTone: Record<string, string> = {
  開発中: "border-wood-500/40 bg-wood-600/10 text-wood-600",
  デモ公開中: "border-moss-500/40 bg-moss-500/10 text-moss-500",
  リリース済み: "border-gold-400/40 bg-gold-300/10 text-gold-400",
};
---

<Layout title="ゲーム" description="開発中・リリース済みの自作ゲーム紹介。">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-cream-100 sm:text-4xl">ゲーム</h1>
      <p class="mt-3 text-sm leading-relaxed text-mist-400 sm:text-base">
        箱庭で育てているゲームたち。スクリーンショットと進捗ステータスを随時更新します。
      </p>
    </div>

    <div class="mt-8 space-y-8">
      {
        games.map((game) => (
          <article class="grid gap-6 rounded-sm border border-forest-600 bg-forest-800 p-5 shadow-sm sm:p-6 lg:grid-cols-[1.1fr_1fr] lg:gap-8">
            <div
              class="relative flex aspect-video items-center justify-center overflow-hidden rounded-sm border border-forest-600 bg-gradient-to-br from-forest-900 via-forest-800 to-forest-700"
              role="img"
              aria-label={game.screenshotAlt}
            >
              <div class="absolute inset-0 opacity-50" aria-hidden="true">
                <div class="absolute left-1/4 top-1/3 h-24 w-24 rounded-full bg-gold-300/25 blur-2xl" />
                <div class="absolute bottom-1/4 right-1/4 h-20 w-32 rounded-full bg-wood-500/20 blur-2xl" />
              </div>
              <p class="relative z-10 text-xs font-medium tracking-wide text-mist-500">スクリーンショット予定</p>
            </div>
            <div class="flex flex-col">
              <div class="flex flex-wrap items-center gap-2">
                <span class:list={["rounded-sm border px-2 py-0.5 text-[0.7rem]", statusTone[game.status]]}>
                  {game.status}
                </span>
                <span class="text-xs text-mist-500">{game.platforms}</span>
              </div>
              <h2 class="mt-3 text-2xl font-bold tracking-tight text-cream-100">{game.title}</h2>
              <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-mist-400">{game.summary}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12">
      <AdSlot size="banner" />
    </div>
  </section>
</Layout>

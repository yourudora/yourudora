---
import Layout from "../../layouts/Layout.astro";
import DonationSlot from "../../components/DonationSlot.astro";
import DownloadLink from "../../components/DownloadLink.astro";
import SourceCodeButton from "../../components/SourceCodeButton.astro";
import { getPluginBySlug, getPluginImage, plugins } from "../../data/plugins";

export function getStaticPaths() {
  return plugins.map((plugin) => ({
    params: { slug: plugin.slug },
  }));
}

const { slug } = Astro.params;
const plugin = getPluginBySlug(slug ?? "");

if (!plugin) {
  return Astro.redirect("/plugins/");
}

const imageSrc = getPluginImage(plugin);
const imageAlt = plugin.imageAlt ?? `${plugin.title}のアイキャッチ画像`;
---

<Layout title={plugin.title} description={plugin.shortDescription}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
    <p class="text-sm">
      <a href="/plugins/" class="text-mist-400 hover:text-gold-300">プラグイン一覧</a>
      <span class="mx-2 text-mist-500" aria-hidden="true">/</span>
      <span class="text-cream-200">{plugin.title}</span>
    </p>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:items-start">
      <div class="card-surface overflow-hidden">
        <img
          src={imageSrc}
          alt={imageAlt}
          class="aspect-[4/3] w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          <time class="font-mono text-xs text-mist-500" datetime={plugin.updatedAt}>
            {plugin.updatedAt}
          </time>
          <span class="rounded-sm border border-moss-500/40 bg-moss-500/15 px-2 py-0.5 text-[0.7rem] font-medium text-moss-400">
            {plugin.category}
          </span>
          <span class="text-xs text-mist-500">{plugin.engine}</span>
        </div>

        <h1 class="mt-3 text-3xl font-bold tracking-tight text-cream-100 sm:text-4xl">
          {plugin.title}
        </h1>
        <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-mist-400 sm:text-base">
          {plugin.description}
        </p>

        <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
          <DownloadLink
            href={plugin.downloadHref}
            class="inline-flex w-full items-center justify-center rounded-sm border border-gold-400/50 bg-gold-400/15 px-4 py-2.5 text-sm font-bold text-gold-300 transition hover:bg-gold-400/25 hover:text-cream-100 sm:w-auto"
          >
            ダウンロード
          </DownloadLink>
          {
            plugin.sourceHref && (
              <SourceCodeButton
                id={plugin.slug}
                href={plugin.sourceHref}
                title={`${plugin.title} のソースコード`}
              />
            )
          }
          {
            plugin.donationHref && (
              <a
                href={plugin.donationHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center rounded-sm border border-forest-600 bg-forest-700/50 px-4 py-2.5 text-sm text-cream-200 transition hover:border-gold-400/40 hover:text-gold-300 sm:w-auto"
              >
                OFUSEで応援
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div class="mt-12">
      <DonationSlot />
    </div>
  </section>
</Layout>

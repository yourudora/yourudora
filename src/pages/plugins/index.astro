---
import Layout from "../../layouts/Layout.astro";
import CatalogControls from "../../components/CatalogControls.astro";
import DonationSlot from "../../components/DonationSlot.astro";
import PluginCard from "../../components/PluginCard.astro";
import { getPluginGenres, getPluginsNewestFirst } from "../../data/plugins";

const plugins = getPluginsNewestFirst();
const genres = getPluginGenres();
---

<Layout title="プラグイン" description="自作ゲームエンジンプラグインの無料配布一覧。">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h1 class="text-3xl font-bold tracking-tight text-cream-100 sm:text-4xl">プラグイン一覧</h1>
      <CatalogControls listId="plugins-page" genres={genres} />
    </div>

    <div
      class="mt-8 grid grid-cols-1 gap-5 overflow-visible py-2 sm:grid-cols-2 lg:grid-cols-3"
      data-sort-grid="plugins-page"
    >
      {
        plugins.map((plugin) => (
          <div
            data-sort-item
            data-updated-at={plugin.updatedAt}
            data-name={plugin.title}
            data-genre={plugin.category}
          >
            <PluginCard plugin={plugin} />
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-mist-400" data-filter-empty="plugins-page" hidden>
      該当するジャンルのプラグインはありません。
    </p>

    <div class="mt-12">
      <DonationSlot />
    </div>
  </section>
</Layout>

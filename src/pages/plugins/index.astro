---
import Layout from "../../layouts/Layout.astro";
import DonationSlot from "../../components/DonationSlot.astro";
import PluginCard from "../../components/PluginCard.astro";
import SortControls from "../../components/SortControls.astro";
import { getPluginsNewestFirst } from "../../data/plugins";

const plugins = getPluginsNewestFirst();
---

<Layout title="プラグイン" description="自作ゲームエンジンプラグインの無料配布一覧。">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h1 class="text-3xl font-bold tracking-tight text-cream-100 sm:text-4xl">プラグイン一覧</h1>
        <p class="mt-3 text-sm leading-relaxed text-mist-400 sm:text-base">
          カードを選ぶと詳細ページへ移動します。対応エンジンと概要を確認のうえダウンロードしてください。
        </p>
      </div>
      <SortControls listId="plugins-page" />
    </div>

    <div
      class="mt-8 grid grid-cols-1 gap-5 overflow-visible py-2 sm:grid-cols-2 lg:grid-cols-3"
      data-sort-grid="plugins-page"
    >
      {
        plugins.map((plugin) => (
          <div data-sort-item data-updated-at={plugin.updatedAt} data-name={plugin.title}>
            <PluginCard plugin={plugin} />
          </div>
        ))
      }
    </div>

    <div class="mt-12">
      <DonationSlot />
    </div>
  </section>
</Layout>

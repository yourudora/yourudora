---
import Layout from "../../layouts/Layout.astro";
import DonationSlot from "../../components/DonationSlot.astro";
import { site } from "../../data/site";
---

<Layout title="お問い合わせ" description={`${site.name}へのお問い合わせ。`}>
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-cream-100 sm:text-4xl">お問い合わせ</h1>
      <p class="mt-3 text-sm leading-relaxed text-mist-400 sm:text-base">
        プラグインやサイトに関するご質問・ご要望は、以下のフォームまたはソーシャルアカウントよりご連絡ください。
      </p>
    </div>

    <article id="contact-form" class="card-surface mt-8 p-5 sm:p-6">
      <p class="text-sm leading-relaxed text-mist-400">
        フォーム連携は今後追加予定です。当面はソーシャルアカウントまたは下記よりご連絡ください。
      </p>

      <form class="mt-6 space-y-4" action="#" method="get" data-contact-form>
        <div>
          <label for="name" class="block text-xs font-medium text-mist-500">お名前</label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            class="mt-1.5 w-full rounded-sm border border-forest-600 bg-forest-950 px-3 py-2 text-sm text-cream-100 outline-none transition focus:border-gold-400"
            placeholder="山田 太郎"
          />
        </div>
        <div>
          <label for="email" class="block text-xs font-medium text-mist-500">メールアドレス</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            class="mt-1.5 w-full rounded-sm border border-forest-600 bg-forest-950 px-3 py-2 text-sm text-cream-100 outline-none transition focus:border-gold-400"
            placeholder="you@example.com"
          />
        </div>
        <div>
          <label for="message" class="block text-xs font-medium text-mist-500">メッセージ</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            class="mt-1.5 w-full resize-y rounded-sm border border-forest-600 bg-forest-950 px-3 py-2 text-sm text-cream-100 outline-none transition focus:border-gold-400"
            placeholder="ご質問・ご要望など"
          ></textarea>
        </div>
        <button
          type="submit"
          class="inline-flex items-center rounded-sm border border-gold-400/50 bg-gold-400/15 px-5 py-2.5 text-sm font-bold text-gold-300 transition hover:bg-gold-400/25 hover:text-cream-100"
        >
          送信（準備中）
        </button>
      </form>

      <div class="mt-8 border-t border-forest-600 pt-5">
        <p class="text-xs font-medium text-mist-500">ソーシャル</p>
        <ul class="mt-3 flex flex-wrap gap-3 text-sm">
          <li>
            <a href={site.social.twitter} class="text-cream-200 hover:text-gold-300" target="_blank" rel="noopener noreferrer"
              >X（旧Twitter）</a
            >
          </li>
          <li>
            <a href={site.social.youtube} class="text-cream-200 hover:text-gold-300" target="_blank" rel="noopener noreferrer"
              >YouTube</a
            >
          </li>
        </ul>
      </div>
    </article>

    <div class="mt-12">
      <DonationSlot />
    </div>
  </section>
</Layout>

<script>
  document.querySelector("[data-contact-form]")?.addEventListener("submit", (event) => {
    event.preventDefault();
  });
</script>

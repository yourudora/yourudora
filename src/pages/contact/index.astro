---
import Layout from "../../layouts/Layout.astro";
import DonationSlot from "../../components/DonationSlot.astro";
import { site } from "../../data/site";
---

<Layout title="お問い合わせ" description={`${site.name}へのお問い合わせ。`}>
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight text-cream-100 sm:text-4xl">お問い合わせ</h1>
      <p class="mt-3 text-sm leading-relaxed text-mist-400 sm:text-base">
        プラグインやサイトに関するご質問・ご要望は、以下のフォームまたはソーシャルアカウントよりご連絡ください。
      </p>
    </div>

    <article id="contact-form" class="card-surface mt-8 overflow-hidden">
      <div class="relative w-full bg-forest-950">
        <iframe
          class="block h-[min(90vh,1100px)] min-h-[640px] w-full border-0"
          src={site.contactFormEmbedUrl}
          title="お問い合わせフォーム"
          loading="lazy"
        >
          読み込んでいます…
        </iframe>
      </div>

      <div class="border-t border-forest-600 px-5 py-5 sm:px-6">
        <p class="text-xs font-medium text-mist-500">ソーシャル</p>
        <ul class="mt-3 flex flex-wrap gap-3 text-sm">
          <li>
            <a
              href={site.social.twitter}
              class="text-cream-200 hover:text-gold-300"
              target="_blank"
              rel="noopener noreferrer"
            >
              X（旧Twitter）
            </a>
          </li>
          <li>
            <a
              href={site.social.youtube}
              class="text-cream-200 hover:text-gold-300"
              target="_blank"
              rel="noopener noreferrer"
            >
              YouTube
            </a>
          </li>
        </ul>
      </div>
    </article>

    <div class="mt-12">
      <DonationSlot />
    </div>
  </section>
</Layout>

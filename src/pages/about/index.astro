---
import Layout from "../../layouts/Layout.astro";
import DonationSlot from "../../components/DonationSlot.astro";
import { site } from "../../data/site";
---

<Layout title="About / Contact" description="ユルドラの箱庭についての紹介とお問い合わせ。">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-16">
    <div class="max-w-2xl">
      <h1 class="font-display text-3xl text-gold-300 sm:text-4xl">About / Contact</h1>
      <p class="mt-3 text-sm leading-relaxed text-mist-400 sm:text-base">
        このサイトと、箱庭を手入れしている人についての短い紹介です。
      </p>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <article class="space-y-4">
        <h2 class="font-display text-2xl text-cream-100">{site.name}について</h2>
        <p class="text-sm leading-relaxed text-mist-400 sm:text-base">
          {site.name}は、自作のゲームエンジン向けプラグインを無料で配布し、あわせて開発中の自作ゲームの最新情報を届けるための小さな庭です。
        </p>
        <p class="text-sm leading-relaxed text-mist-400 sm:text-base">
          ゲーム開発者とインディーゲームファン、どちらも歓迎しています。プラグインを試したり、開発ログを眺めたり、気軽に立ち寄ってもらえる場所を目指しています。
        </p>
        <p class="text-sm leading-relaxed text-mist-400 sm:text-base">
          運営: {site.author}
        </p>
      </article>

      <article class="border border-forest-600/70 bg-forest-800/35 p-5 sm:p-6">
        <h2 class="font-display text-2xl text-cream-100">お問い合わせ</h2>
        <p class="mt-3 text-sm leading-relaxed text-mist-400">
          フォーム連携は今後追加予定です。当面は SNS または下記メールへご連絡ください。
        </p>

        <form class="mt-6 space-y-4" action="#" method="get" data-contact-form>
          <div>
            <label for="name" class="block text-xs tracking-wide text-mist-500">お名前</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              class="mt-1.5 w-full rounded-sm border border-forest-600 bg-forest-950/60 px-3 py-2 text-sm text-cream-100 outline-none transition focus:border-gold-400/50"
              placeholder="山田 太郎"
            />
          </div>
          <div>
            <label for="email" class="block text-xs tracking-wide text-mist-500">メールアドレス</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              class="mt-1.5 w-full rounded-sm border border-forest-600 bg-forest-950/60 px-3 py-2 text-sm text-cream-100 outline-none transition focus:border-gold-400/50"
              placeholder="you@example.com"
            />
          </div>
          <div>
            <label for="message" class="block text-xs tracking-wide text-mist-500">メッセージ</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="mt-1.5 w-full resize-y rounded-sm border border-forest-600 bg-forest-950/60 px-3 py-2 text-sm text-cream-100 outline-none transition focus:border-gold-400/50"
              placeholder="ご質問・ご要望など"
            ></textarea>
          </div>
          <button
            type="submit"
            class="inline-flex items-center rounded-sm border border-gold-400/50 bg-gold-400/10 px-5 py-2.5 text-sm text-gold-300 transition hover:bg-gold-400/20"
          >
            送信（準備中）
          </button>
        </form>

        <div class="mt-8 border-t border-forest-600/60 pt-5">
          <p class="text-xs uppercase tracking-[0.2em] text-mist-500">SNS</p>
          <ul class="mt-3 flex flex-wrap gap-3 text-sm">
            <li>
              <a href={site.social.twitter} class="text-cream-200/85 hover:text-gold-300" target="_blank" rel="noopener noreferrer"
                >X (Twitter)</a
              >
            </li>
            <li>
              <a href={site.social.github} class="text-cream-200/85 hover:text-gold-300" target="_blank" rel="noopener noreferrer"
                >GitHub</a
              >
            </li>
            <li>
              <a href={site.social.youtube} class="text-cream-200/85 hover:text-gold-300" target="_blank" rel="noopener noreferrer"
                >YouTube</a
              >
            </li>
          </ul>
        </div>
      </article>
    </div>

    <div class="mt-12">
      <DonationSlot />
    </div>
  </section>
</Layout>

<script>
  document.querySelector("[data-contact-form]")?.addEventListener("submit", (event) => {
    event.preventDefault();
  });
</script>

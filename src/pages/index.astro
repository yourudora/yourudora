---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import DonationSlot from "../components/DonationSlot.astro";
import DownloadLink from "../components/DownloadLink.astro";
import { getChangelogNewestFirst, getPluginsNewestFirst } from "../data/site";

const newestPlugins = getPluginsNewestFirst();
const newestChangelog = getChangelogNewestFirst();
---

<Layout>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <!-- 1. Plugins (newest first) -->
    <div class="animate-fade-in">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="text-xl font-bold tracking-tight text-cream-100 sm:text-2xl">
          プラグイン一覧
        </h2>
        <a href="/plugins/" class="text-sm font-medium text-gold-300 hover:text-gold-400">
          すべて見る
        </a>
      </div>

      <div class="mt-5 grid gap-3">
        {
          newestPlugins.map((plugin) => (
            <article class="card-surface p-4 sm:p-5">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <time class="font-mono text-xs text-mist-500" datetime={plugin.updatedAt}>
                      {plugin.updatedAt}
                    </time>
                    <span class="rounded-sm border border-moss-500/40 bg-moss-500/15 px-2 py-0.5 text-[0.7rem] font-medium text-moss-400">
                      {plugin.category}
                    </span>
                    <span class="text-xs text-mist-500">{plugin.engine}</span>
                  </div>
                  <h3 class="mt-2 text-lg font-bold text-cream-100">{plugin.title}</h3>
                  <p class="mt-1.5 whitespace-pre-line text-sm leading-relaxed text-mist-400">
                    {plugin.summary}
                  </p>
                </div>
                <div class="flex shrink-0 flex-wrap gap-2">
                  <DownloadLink
                    href={plugin.downloadHref}
                    class="inline-flex items-center rounded-sm border border-gold-400/50 bg-gold-400/15 px-4 py-2 text-sm font-bold text-gold-300 transition hover:bg-gold-400/25 hover:text-cream-100"
                  >
                    ダウンロード
                  </DownloadLink>
                  {plugin.donationHref && (
                    <a
                      href={plugin.donationHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center rounded-sm border border-forest-600 bg-forest-700/50 px-4 py-2 text-sm text-cream-200 transition hover:border-gold-400/40 hover:text-gold-300"
                    >
                      OFUSEで応援
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- 2. Changelog / news (newest first) -->
    <div class="animate-fade-up mt-10" style="animation-delay: 0.08s">
      <h2 class="text-xl font-bold tracking-tight text-cream-100 sm:text-2xl">更新履歴・お知らせ</h2>

      <ol class="card-surface mt-5 divide-y divide-forest-600">
        {
          newestChangelog.map((item) => (
            <li class="flex flex-col gap-1 px-4 py-3.5 sm:flex-row sm:items-baseline sm:gap-5 sm:px-5">
              <time class="shrink-0 font-mono text-xs font-medium text-moss-400" datetime={item.date}>
                {item.date}
              </time>
              {item.href ? (
                <a href={item.href} class="text-sm text-cream-200 hover:text-gold-300">
                  {item.label}
                </a>
              ) : (
                <span class="text-sm text-cream-200">{item.label}</span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-t border-forest-600">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 lg:px-8">
      <AdSlot size="banner" />
      <DonationSlot />
    </div>
  </section>
</Layout>

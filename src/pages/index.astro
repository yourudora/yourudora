---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import DonationSlot from "../components/DonationSlot.astro";
import PickupCard from "../components/PickupCard.astro";
import { latestNews, pickupItems, site } from "../data/site";
---

<Layout description={site.description}>
  <!-- Hero: brand-first, one composition -->
  <section class="relative isolate overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 animate-soft-drift opacity-70"
      aria-hidden="true"
    >
      <div
        class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-moss-500/20 blur-3xl"
      >
      </div>
      <div
        class="absolute right-0 top-0 h-[28rem] w-[28rem] rounded-full bg-wood-500/10 blur-3xl"
      >
      </div>
      <div
        class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-forest-900 to-transparent"
      >
      </div>
    </div>
    <div class="garden-grain pointer-events-none absolute inset-0 -z-10 opacity-[0.04]" aria-hidden="true"></div>

    <div
      class="mx-auto flex min-h-[calc(100dvh-3.5rem)] max-w-6xl flex-col justify-center px-4 py-16 sm:px-6 lg:px-8 lg:py-20"
    >
      <p
        class="animate-fade-in text-xs uppercase tracking-[0.28em] text-moss-300"
        style="animation-delay: 0.05s"
      >
        Free Plugins & Indie Games
      </p>
      <h1
        class="animate-fade-up mt-4 font-display text-4xl leading-tight tracking-wide text-gold-300 sm:text-5xl md:text-6xl lg:text-7xl"
        style="animation-delay: 0.12s"
      >
        {site.name}
      </h1>
      <p
        class="animate-fade-up mt-5 max-w-xl text-base leading-relaxed text-cream-200/85 sm:text-lg"
        style="animation-delay: 0.28s"
      >
        {site.tagline}
      </p>

      <div
        class="animate-fade-up mt-8 flex flex-wrap gap-3"
        style="animation-delay: 0.4s"
      >
        <a
          href="/plugins/"
          class="inline-flex items-center justify-center rounded-sm border border-gold-400/50 bg-gold-400/10 px-5 py-2.5 text-sm font-medium text-gold-300 transition hover:bg-gold-400/20"
        >
          プラグインを見る
        </a>
        <a
          href="/games/"
          class="inline-flex items-center justify-center rounded-sm border border-forest-600 px-5 py-2.5 text-sm text-cream-200/90 transition hover:border-moss-400/50 hover:text-cream-100"
        >
          開発中のゲーム
        </a>
      </div>

      <!-- Latest news (kept within hero budget as supporting signal) -->
      <div
        class="animate-fade-up mt-12 max-w-2xl border-t border-forest-600/60 pt-6"
        style="animation-delay: 0.55s"
      >
        <p class="text-xs uppercase tracking-[0.22em] text-mist-500">Latest</p>
        <ul class="mt-3 space-y-2.5">
          {
            latestNews.slice(0, 3).map((item) => (
              <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-4">
                <time class="shrink-0 font-mono text-xs text-moss-400" datetime={item.date}>
                  {item.date}
                </time>
                {item.href ? (
                  <a href={item.href} class="text-sm text-cream-200/90 hover:text-gold-300">
                    {item.label}
                  </a>
                ) : (
                  <span class="text-sm text-cream-200/90">{item.label}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Pickup -->
  <section class="border-t border-forest-700/50 bg-forest-950/30">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl text-cream-100 sm:text-4xl">ピックアップ</h2>
        <p class="mt-3 text-sm leading-relaxed text-mist-400 sm:text-base">
          いま注目のプラグインと、育てているゲームをひとつずつ。
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {pickupItems.map((item) => <PickupCard item={item} />)}
      </div>
    </div>
  </section>

  <!-- Monetization-ready slots -->
  <section class="border-t border-forest-700/40">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 lg:px-8">
      <AdSlot size="banner" />
      <DonationSlot />
    </div>
  </section>
</Layout>

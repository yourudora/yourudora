---
import Layout from "../layouts/Layout.astro";
import CatalogControls from "../components/CatalogControls.astro";
import DonationSlot from "../components/DonationSlot.astro";
import GameCard from "../components/GameCard.astro";
import PluginCard from "../components/PluginCard.astro";
import { getGameGenres, getGamesNewestFirst } from "../data/games";
import { getPluginGenres, getPluginsNewestFirst } from "../data/plugins";
import { getChangelogNewestFirst } from "../data/site";

const newestPlugins = getPluginsNewestFirst();
const newestGames = getGamesNewestFirst();
const newestChangelog = getChangelogNewestFirst();
const pluginGenres = getPluginGenres();
const gameGenres = getGameGenres();
---

<Layout>
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-4 sm:px-6 sm:pb-10 sm:pt-5 lg:px-8">
    <!-- 1. Changelog (compact; scroll when more than 4 items) -->
    <div class="intro-reveal intro-reveal--2">
      <h2 class="text-xl font-bold tracking-tight text-cream-100 sm:text-2xl">更新履歴</h2>

      <ol class="changelog-list card-surface mt-2.5 divide-y divide-forest-600 overflow-y-auto">
        {
          newestChangelog.map((item) => (
            <li>
              {item.href ? (
                <a
                  href={item.href}
                  class="group flex flex-col gap-0.5 px-3 py-2 transition hover:bg-forest-700/70 sm:flex-row sm:items-baseline sm:gap-4 sm:px-4"
                >
                  <time class="shrink-0 font-mono text-xs font-medium text-moss-400 sm:text-[0.8125rem]" datetime={item.date}>
                    {item.date}
                  </time>
                  <span class="text-xs text-cream-200 transition group-hover:text-gold-300 sm:text-[0.8125rem]">
                    {item.label}
                  </span>
                </a>
              ) : (
                <div class="flex flex-col gap-0.5 px-3 py-2 sm:flex-row sm:items-baseline sm:gap-4 sm:px-4">
                  <time class="shrink-0 font-mono text-xs font-medium text-moss-400 sm:text-[0.8125rem]" datetime={item.date}>
                    {item.date}
                  </time>
                  <span class="text-xs text-cream-200 sm:text-[0.8125rem]">{item.label}</span>
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <!-- 2. Plugins -->
    <div class="intro-reveal intro-reveal--3 mt-10">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="flex flex-wrap items-end gap-3">
          <h2 class="text-xl font-bold tracking-tight text-cream-100 sm:text-2xl">
            プラグイン一覧
          </h2>
          <a href="/plugins/" class="text-sm font-medium text-gold-300 hover:text-gold-400">
            すべて見る
          </a>
        </div>
        <CatalogControls listId="plugins-home" genres={pluginGenres} />
      </div>

      <div
        class="mt-5 grid grid-cols-1 gap-5 overflow-visible py-2 sm:grid-cols-2 lg:grid-cols-3"
        data-sort-grid="plugins-home"
      >
        {
          newestPlugins.map((plugin) => (
            <div
              data-sort-item
              data-updated-at={plugin.updatedAt}
              data-name={plugin.title}
              data-genre={plugin.category}
            >
              <PluginCard plugin={plugin} />
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-mist-400" data-filter-empty="plugins-home" hidden>
        該当するジャンルのプラグインはありません。
      </p>
    </div>

    <!-- 3. Games -->
    <div class="intro-reveal intro-reveal--4 mt-10">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="flex flex-wrap items-end gap-3">
          <h2 class="text-xl font-bold tracking-tight text-cream-100 sm:text-2xl">
            ゲーム一覧
          </h2>
          <a href="/games/" class="text-sm font-medium text-gold-300 hover:text-gold-400">
            すべて見る
          </a>
        </div>
        <CatalogControls listId="games-home" genres={gameGenres} />
      </div>

      <div
        class="mt-5 grid grid-cols-1 gap-5 overflow-visible py-2 sm:grid-cols-2 lg:grid-cols-3"
        data-sort-grid="games-home"
      >
        {
          newestGames.map((game) => (
            <div
              data-sort-item
              data-updated-at={game.updatedAt}
              data-name={game.title}
              data-genre={game.genre}
            >
              <GameCard game={game} />
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-mist-400" data-filter-empty="games-home" hidden>
        該当するジャンルのゲームはありません。
      </p>
    </div>
  </section>

  <section class="border-t border-forest-600">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <DonationSlot />
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import DonationSlot from "../components/DonationSlot.astro";
import PickupCard from "../components/PickupCard.astro";
import { heroFeatures, latestNews, pickupItems, site } from "../data/site";
---

<Layout description={site.description}>
  <!-- Hero: cyber first-view -->
  <section class="relative isolate overflow-hidden">
    <div class="cyber-grid pointer-events-none absolute inset-0 -z-10 opacity-80" aria-hidden="true"></div>
    <div class="cyber-scan pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 -z-10 animate-soft-drift"
      aria-hidden="true"
    >
      <div class="absolute -left-20 top-8 h-80 w-80 rounded-full bg-gold-400/15 blur-3xl animate-pulse-glow"></div>
      <div class="absolute right-0 top-0 h-[28rem] w-[28rem] rounded-full bg-wood-600/20 blur-3xl"></div>
      <div class="absolute bottom-10 left-1/3 h-56 w-56 rounded-full bg-moss-500/15 blur-3xl"></div>
    </div>

    <div
      class="mx-auto flex min-h-[calc(100dvh-6.5rem)] max-w-6xl flex-col justify-center px-4 py-14 sm:px-6 lg:px-8 lg:py-16"
    >
      <p
        class="animate-fade-in font-display text-xs font-bold uppercase tracking-[0.32em] text-gold-300"
        style="animation-delay: 0.05s"
      >
        Free Plugins & Indie Games
      </p>

      <h1
        class="animate-fade-up mt-4 font-display text-4xl font-extrabold leading-[1.1] tracking-wide text-neon sm:text-5xl md:text-6xl lg:text-7xl"
        style="animation-delay: 0.1s"
      >
        {site.name}
      </h1>

      <p
        class="animate-fade-up mt-5 max-w-2xl text-xl font-bold leading-snug text-cream-100 sm:text-2xl md:text-3xl"
        style="animation-delay: 0.2s"
      >
        敵の技をコピーする。<br class="sm:hidden" />無料プラグインと自作ゲームの箱庭。
      </p>

      <p
        class="animate-fade-up mt-4 max-w-xl text-sm leading-relaxed text-mist-400 sm:text-base"
        style="animation-delay: 0.3s"
      >
        {site.tagline} — 一目でわかる機能と、すぐ試せる配布物を置いています。
      </p>

      <div
        class="animate-fade-up mt-8 flex flex-wrap gap-3"
        style="animation-delay: 0.38s"
      >
        <a
          href="/plugins/"
          class="inline-flex items-center justify-center rounded-sm border border-gold-400/60 bg-gold-400/15 px-5 py-2.5 text-sm font-bold text-gold-300 shadow-[0_0_24px_rgba(34,211,238,0.18)] transition hover:bg-gold-400/25"
        >
          プラグインを見る
        </a>
        <a
          href="/games/"
          class="inline-flex items-center justify-center rounded-sm border border-forest-600 px-5 py-2.5 text-sm font-medium text-cream-200/90 transition hover:border-wood-500/60 hover:text-cream-100"
        >
          開発中のゲーム
        </a>
      </div>

      <!-- Feature cards: what the tools do -->
      <div
        class="animate-fade-up mt-12 grid gap-3 sm:grid-cols-3"
        style="animation-delay: 0.48s"
      >
        {
          heroFeatures.map((feature) => (
            <a
              href={feature.href}
              class="group relative overflow-hidden rounded-sm border border-forest-600/80 bg-forest-800/50 p-5 transition duration-300 hover:border-gold-400/50 hover:bg-forest-700/50 border-neon"
            >
              <div
                class="pointer-events-none absolute -right-6 -top-6 h-20 w-20 rounded-full bg-gold-400/10 blur-2xl transition group-hover:bg-gold-400/20"
                aria-hidden="true"
              />
              <div class="flex h-10 w-10 items-center justify-center rounded-sm border border-gold-400/30 bg-forest-950/70 text-gold-300">
                {feature.icon === "copy" && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="9" y="9" width="10" height="10" rx="1.5" />
                    <path d="M7 15H6a1.5 1.5 0 0 1-1.5-1.5v-9A1.5 1.5 0 0 1 6 3h9A1.5 1.5 0 0 1 16.5 4.5V6" stroke-linecap="round" />
                  </svg>
                )}
                {feature.icon === "plugin" && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M9 3v3M15 3v3" stroke-linecap="round" />
                    <path d="M7 8h10v9a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V8Z" stroke-linejoin="round" />
                    <path d="M9 13h6" stroke-linecap="round" />
                  </svg>
                )}
                {feature.icon === "game" && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M6 9h12a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3Z" stroke-linejoin="round" />
                    <path d="M8 14h.01M16 14h.01M12 12v4" stroke-linecap="round" />
                  </svg>
                )}
              </div>
              <h2 class="mt-4 font-display text-sm font-bold uppercase tracking-[0.12em] text-cream-100 group-hover:text-gold-300">
                {feature.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-mist-400">{feature.summary}</p>
            </a>
          ))
        }
      </div>

      <div
        class="animate-fade-up mt-12 max-w-2xl border-t border-forest-600/70 pt-6"
        style="animation-delay: 0.58s"
      >
        <p class="font-display text-xs uppercase tracking-[0.22em] text-mist-500">Latest</p>
        <ul class="mt-3 space-y-2.5">
          {
            latestNews.slice(0, 3).map((item) => (
              <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-4">
                <time class="shrink-0 font-mono text-xs text-moss-400" datetime={item.date}>
                  {item.date}
                </time>
                {item.href ? (
                  <a href={item.href} class="text-sm text-cream-200/90 hover:text-gold-300">
                    {item.label}
                  </a>
                ) : (
                  <span class="text-sm text-cream-200/90">{item.label}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Pickup -->
  <section class="border-t border-forest-700/60 bg-forest-950/40">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold tracking-wide text-cream-100 sm:text-4xl">
          ピックアップ
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-mist-400 sm:text-base">
          いま注目のプラグインと、育てているゲームをひとつずつ。
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {pickupItems.map((item) => <PickupCard item={item} />)}
      </div>
    </div>
  </section>

  <!-- Monetization-ready slots -->
  <section class="border-t border-forest-700/50">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 lg:px-8">
      <AdSlot size="banner" />
      <DonationSlot />
    </div>
  </section>
</Layout>
